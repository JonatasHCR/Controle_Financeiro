# Copie para .env e preencha. As variaveis marcadas [infra] sao mantidas em dia
# pelo infra/scripts/sync_host_ip.py — edite no infra/.env, nao aqui.

# --- banco (local deste projeto) -------------------------------------------
POSTGRES_USER=controle_financeiro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=controle_financeiro
POSTGRES_DB_TEST=controle_financeiro_test

# --- SSO --------------------------------------------------------------------
# [infra] IP fixo da maquina que hospeda os sistemas.
HOST_IP=10.0.0.143
# [infra] segredo do client controle-financeiro-web no realm ufc.
CONTROLE_FINANCEIRO_CLIENT_SECRET=
# Local deste projeto: chave da sessao. Gere com `openssl rand -hex 32`.
CONTROLE_FINANCEIRO_SESSION_SECRET=
OIDC_REQUIRED_GROUP=/apps/controle-financeiro
# [infra] conta mestra: entra como admin sem depender de grupo.
ADMIN_MESTRE_EMAIL=

# --- portas -----------------------------------------------------------------
# [infra] a deste sistema e as dos outros, para o seletor "Sistemas" e o sync.
CONTROLE_FINANCEIRO_PORT=3060
PORTAL_PORT=3080
INVENTARIO_PORT=3030
RECEITA_PORT=3040
DESPESA_PORT=3010
CONTROLE_DESPESA_PORT=3050

# --- sincronizacao ----------------------------------------------------------
# [infra] copiados do SYNC_API_TOKEN da Receita e do Controle de Despesa.
RECEITA_API_TOKEN=
CONTROLE_API_TOKEN=
SYNC_INTERVAL_MINUTES=15

# --- backup -----------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- app --------------------------------------------------------------------
APP_CONFIG=prod
